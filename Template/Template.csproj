<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Common.props"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>GermanBrainrot</AssemblyName>
        <Description>German meme streamer sounds synced to creature audio</Description>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>

        <NumberOfClients>2</NumberOfClients>
        <DelayBetweenClientsInSeconds>5</DelayBetweenClientsInSeconds>
        <PingDelay>$([MSBuild]::Add($(DelayBetweenClientsInSeconds), 1))</PingDelay>
        <StartGame>false</StartGame>

        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerSkip>true</MinVerSkip>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*"/>
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile"/>
        <PackageReference Include="Concentus" Version="2.2.2"/>
        <PackageReference Include="Concentus.Oggfile" Version="1.0.7"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="config\creature-profiles.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="audio\packs\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="NetcodePatch" AfterTargets="PostBuildEvent" Condition="'$(SkipNetcodePatch)' != 'true'">
        <PropertyGroup>
            <NetcodePatchExe Condition="Exists('$(USERPROFILE)\.dotnet\tools\netcode-patch.exe')">$(USERPROFILE)\.dotnet\tools\netcode-patch.exe</NetcodePatchExe>
            <NetcodePatchExe Condition="'$(NetcodePatchExe)' == ''">netcode-patch</NetcodePatchExe>
            <NetcodePatcherDepsListFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)ncp-deps.list</NetcodePatcherDepsListFile>
            <NetcodePatchCommand Condition="'$(CI)' == 'true'">&quot;$(NetcodePatchExe)&quot; &quot;$(TargetPath)&quot; --dependency-file &quot;$(NetcodePatcherDepsListFile)&quot;</NetcodePatchCommand>
            <NetcodePatchCommand Condition="'$(CI)' != 'true'">&quot;$(NetcodePatchExe)&quot; &quot;$(TargetPath)&quot; &quot;$(AssemblyGameDir)Unity.Netcode.Runtime.dll&quot; &quot;$(IntermediateOutputPath)publicized\Assembly-CSharp.dll&quot;</NetcodePatchCommand>
        </PropertyGroup>
        <WriteLinesToFile Condition="'$(CI)' == 'true'" File="$(NetcodePatcherDepsListFile)" Lines="@(ReferencePathWithRefAssemblies)" Overwrite="true"/>
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(NetcodePatchCommand)"/>
    </Target>

    <Target Name="ClearReferenceCopyLocalPaths" AfterTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyPluginDependencies" AfterTargets="Build">
        <ItemGroup>
            <_PluginDependencyDll Include="@(ReferencePathWithRefAssemblies)"
                                  Condition="'%(Filename)' == 'Concentus'
                                             Or '%(Filename)' == 'Concentus.Oggfile'"/>
        </ItemGroup>
        <Copy SourceFiles="@(_PluginDependencyDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"/>
    </Target>

    <Target Condition="'$(CI)' != 'true' And $(StartGame)" Name="StartGame" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <_PluginDeployFiles Include="$(TargetDir)$(TargetFileName)"/>
            <_PluginDeployFiles Include="$(TargetDir)Concentus.dll"/>
            <_PluginDeployFiles Include="$(TargetDir)Concentus.Oggfile.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(_PluginDeployFiles)" DestinationFolder="$(PluginGameDir)GermanBrainrot\" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')"/>
        <Exec Command='taskkill /F /IM "$(GameExe)" /T || exit 0'/>
        <Exec Command='for /L %%i in (1,1,$(NumberOfClients)) do (start "" "$(GameExePath)" &amp; if %%i lss $(NumberOfClients) (ping 127.0.0.1 -n $(PingDelay) > nul))'/>
    </Target>

    <Target Condition="'$(BuildThunderstorePackage)' == 'true'" Name="ThunderstoreBuild" AfterTargets="PostBuildEvent" DependsOnTargets="NetcodePatch;CopyPluginDependencies">
        <PropertyGroup>
            <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</_RepoRoot>
        </PropertyGroup>
        <Exec WorkingDirectory="$(_RepoRoot)" Command="tcli build --config-path &quot;$(_RepoRoot)thunderstore.toml&quot; --package-version $(Version)"/>
    </Target>
</Project>
